# ===== VoiceBook BFF 配置（复制为 .env 后填写；.env 只放在 NAS 上，不要提交） =====

# ---- docker / 宿主机 ----
# BFF 要和 lldap / miniflux / artalk / calibre-web-automated 处在同一个 docker 网络
DOCKER_NETWORK=sso
# CWA 容器的 PUID/PGID（app.db 的属主）
PUID=1000
PGID=1000
# 宿主机上 calibre 书库目录（含 metadata.db），只读挂载
CALIBRE_LIBRARY_HOST_DIR=/volume1/docker/calibre/library
# 宿主机上 CWA 的 config 目录（含 app.db），读写挂载
CWA_CONFIG_HOST_DIR=/volume1/docker/calibre/config
# 宿主机回环端口，供 nginx 反代
BFF_HOST_PORT=8460

# ---- OIDC（Authelia）----
# Authelia 的公网地址：BFF 代 App 登录时要用它拿会话 cookie，域名必须与 Authelia 的 session 域一致
OIDC_ISSUER=https://nas.wangyl.work:8461
# 与 authelia-client.yml 中的客户端一致（public + PKCE + consent_mode: implicit）
OIDC_CLIENT_ID=voicebook-app
OIDC_REDIRECT_URI=voicebook://oauth2/callback
OIDC_SCOPES=openid profile email groups offline_access
# access_token 是不透明 token，只能通过 userinfo 校验；默认 ${OIDC_ISSUER}/api/oidc/userinfo
# OIDC_USERINFO_URL=
OIDC_USERNAME_CLAIM=preferred_username
OIDC_CACHE_TTL_SECONDS=60

# ---- LLDAP ----
LLDAP_HTTP_URL=http://lldap:17170
LLDAP_LDAP_HOST=lldap
LLDAP_LDAP_PORT=3890
LLDAP_BASE_DN=dc=example,dc=com
LLDAP_ADMIN_USER=admin
LLDAP_ADMIN_PASSWORD=change-me
# 新用户自动加入的分组（按 displayName，逗号分隔），至少包含 CWA LDAP 过滤要求的组
LLDAP_DEFAULT_GROUPS=calibre_web

# ---- Miniflux ----
MINIFLUX_URL=http://miniflux:8080
# Miniflux 管理员账号在「设置 → API 密钥」里生成
MINIFLUX_ADMIN_TOKEN=change-me
# 派生共享账号 Miniflux 密码的 HMAC 密钥，>=32 字符；生成：openssl rand -hex 32
MINIFLUX_PASSWORD_SECRET=change-me-to-a-long-random-string-000000
# 所有用户共用的 Miniflux 账号（BFF 首次调用时自动创建）；每个订阅源只订阅、抓取一次
MINIFLUX_SHARED_USER=voicebook-shared
# 可选：新注册用户自动订阅的源，逗号分隔
# MINIFLUX_DEFAULT_FEEDS=
# BFF 自己的 SQLite（用户订阅关系、已读/收藏状态），需挂载持久卷
BFF_STATE_DB=/data/bff.db

# ---- Artalk ----
ARTALK_URL=http://artalk:23366
ARTALK_SITE_NAME=VoiceBook

# ---- calibre-web-automated ----
CALIBRE_WEB_URL=http://calibre-web-automated:8083

# ---- 安全 ----
REGISTRATION_ENABLED=true
REGISTER_RATE_PER_MINUTE=5
LOGIN_RATE_PER_MINUTE=10
PASSWORD_MIN_LENGTH=8
# App「忘记密码」页的跳转地址（Authelia 已配置邮件通知时可用），留空则提示联系管理员
# PASSWORD_RESET_URL=https://nas.wangyl.work:8461/reset-password/step1
# Web 版 App 的来源（逗号分隔），为空则不启用 CORS
# CORS_ALLOWED_ORIGINS=https://voicebook.example.com
LOG_LEVEL=INFO
