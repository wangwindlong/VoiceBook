CREATE TABLE ReadingHistory (
    bookId INTEGER NOT NULL,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    coverUrl TEXT NOT NULL,
    format TEXT NOT NULL,
    spineIndex INTEGER NOT NULL,
    charOffset INTEGER NOT NULL,
    progress INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    seedColor INTEGER,
    owner TEXT NOT NULL DEFAULT '',
    pending_sync INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(owner, bookId)
);

upsertHistory:
INSERT OR REPLACE INTO ReadingHistory(bookId, title, author, coverUrl, format, spineIndex, charOffset, progress, updatedAt, seedColor, owner, pending_sync)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllHistory:
SELECT * FROM ReadingHistory WHERE owner = :owner ORDER BY updatedAt DESC;

selectHistory:
SELECT * FROM ReadingHistory WHERE bookId = :bookId AND owner = :owner;
