ALTER TABLE ReadingHistory RENAME TO ReadingHistory_old;
CREATE TABLE ReadingHistory (
    bookId INTEGER NOT NULL,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    coverUrl TEXT NOT NULL,
    format TEXT NOT NULL,
    spineIndex INTEGER NOT NULL,
    charOffset INTEGER NOT NULL,
    progress INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    seedColor INTEGER,
    owner TEXT NOT NULL DEFAULT '',
    pending_sync INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(owner, bookId)
);
INSERT INTO ReadingHistory(bookId,title,author,coverUrl,format,spineIndex,charOffset,progress,updatedAt,seedColor) SELECT bookId,title,author,coverUrl,format,spineIndex,charOffset,progress,updatedAt,seedColor FROM ReadingHistory_old;
DROP TABLE ReadingHistory_old;
ALTER TABLE BookCache RENAME TO BookCache_old;
CREATE TABLE BookCache (
    bookId INTEGER NOT NULL,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    coverUrl TEXT NOT NULL,
    epubHref TEXT NOT NULL,
    pos INTEGER NOT NULL,
    seedColor INTEGER,
    owner TEXT NOT NULL DEFAULT '',
    tags TEXT NOT NULL DEFAULT '[]',
    series TEXT,
    publisher TEXT,
    rating REAL,
    pageCount INTEGER,
    languages TEXT NOT NULL DEFAULT '[]',
    metadata TEXT NOT NULL DEFAULT '{}',
    PRIMARY KEY(owner, bookId)
);
INSERT INTO BookCache(bookId,title,author,coverUrl,epubHref,pos,seedColor) SELECT bookId,title,author,coverUrl,epubHref,pos,seedColor FROM BookCache_old;
DROP TABLE BookCache_old;
