CREATE TABLE BookCache (
    bookId INTEGER NOT NULL,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    coverUrl TEXT NOT NULL,
    epubHref TEXT NOT NULL,
    pos INTEGER NOT NULL,
    seedColor INTEGER,
    owner TEXT NOT NULL DEFAULT '',
    tags TEXT NOT NULL DEFAULT '[]',
    series TEXT,
    publisher TEXT,
    rating REAL,
    pageCount INTEGER,
    languages TEXT NOT NULL DEFAULT '[]',
    metadata TEXT NOT NULL DEFAULT '{}',
    PRIMARY KEY(owner, bookId)
);

upsertBookCache:
INSERT OR REPLACE INTO BookCache(bookId, title, author, coverUrl, epubHref, pos, seedColor, owner, tags, series, publisher, rating, pageCount, languages, metadata)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectBookCachePage:
SELECT * FROM BookCache WHERE owner = :owner ORDER BY pos ASC LIMIT :limit OFFSET :offset;

countBookCache:
SELECT COUNT(*) FROM BookCache WHERE owner = :owner;

updateBookCacheSeedColor:
UPDATE BookCache SET seedColor = ? WHERE bookId = :bookId AND owner = :owner;

clearBookCache:
DELETE FROM BookCache WHERE owner = :owner;
