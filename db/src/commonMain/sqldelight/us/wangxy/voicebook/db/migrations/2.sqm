CREATE TABLE SavedServer (
    id TEXT PRIMARY KEY,
    label TEXT NOT NULL,
    baseUrl TEXT NOT NULL,
    username TEXT NOT NULL,
    password TEXT NOT NULL,
    lastUsedAt INTEGER NOT NULL
);
CREATE TABLE SavedRssAccount (
    id TEXT PRIMARY KEY,
    label TEXT NOT NULL,
    mode TEXT NOT NULL,
    serverUrl TEXT,
    token TEXT,
    lastUsedAt INTEGER NOT NULL
);
