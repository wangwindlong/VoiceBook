# 复制为 .env 后填写。此文件不要提交到版本库。
# 值来自 NAS 上的既有部署：
#   LLDAP_ADMIN_PASSWORD → /home/wangyl/work/service/sso/.env 里的 LLDAP_ADMIN_PASS
#   CALIBRE_*            → calibre-web-automated 的本地管理员账号
LLDAP_ADMIN_PASSWORD=change-me
CALIBRE_USERNAME=testuser
CALIBRE_PASSWORD=change-me
# Miniflux 管理员 API token（在 Miniflux「Settings > API Keys」里生成）
MINIFLUX_ADMIN_TOKEN=change-me
# 换掉它会让所有已投影用户的 Miniflux 密码重算（下一次访问自动重设）
MINIFLUX_PASSWORD_SECRET=change-me
